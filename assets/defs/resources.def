# tradingstuff resource definitions (reusable across levels)
# resource <id> <type:auto|raw|manufactured> <rarity:common|uncommon|rare> \
#          <weight> <value_min> <value_max> <volatility> [site_capacity] [site_replenish]
# site_capacity/replenish are defaults for a RAW site of this resource (omit for non-raw).

# --- AUTO_RESTOCKED (placed by cities later, no site) ---
resource passengers auto common 1 2 8  0.10
resource mail       auto common 1 3 9  0.10

# --- RAW (extracted at resource sites) ---
resource coal       raw common   10  5 15 0.20  500 1.0
resource wood       raw common    8  4 12 0.15  500 1.5
resource grain      raw common    6  3 10 0.15  500 2.0
resource ore        raw uncommon 12  8 20 0.25  400 0.8
resource livestock  raw uncommon  9  6 16 0.20  300 1.0
resource poppy      raw rare      4 15 35 0.35  200 0.5

# --- MANUFACTURED (produced by industries) ---
resource beer       manufactured common    7 10 22 0.15
resource oil        manufactured uncommon 11 16 34 0.25
resource paper      manufactured common    6  9 20 0.15
resource food       manufactured common    7 10 22 0.15
resource textiles   manufactured uncommon  8 14 30 0.20
resource steel      manufactured uncommon 15 20 40 0.20
resource medicine   manufactured rare      5 30 60 0.35
resource cars       manufactured rare     18 40 80 0.30
resource arms       manufactured rare     16 45 90 0.40
